<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer; see backup_rules.xml for why the preferences stay on this device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="calendar_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="calendar_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
