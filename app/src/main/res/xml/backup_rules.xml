<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. Calendar data lives in the system Calendar Provider and is backed up by
     its accounts. This app's preferences hold provider calendar IDs, which differ per device, so
     restoring them elsewhere would hide the wrong calendars. -->
<full-backup-content>
    <exclude domain="sharedpref" path="calendar_preferences.xml" />
</full-backup-content>
